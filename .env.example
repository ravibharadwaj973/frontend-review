# Address of the backend API (no trailing slash). The only setting the website needs.
#   Local:      BACKEND_URL=http://localhost:4000
#   Production: BACKEND_URL=https://api.yourbusiness.in
# Copy this file to .env.local for local development. On Vercel, add it under
# Project → Settings → Environment Variables, then redeploy (it is read at build time).
BACKEND_URL=http://localhost:4000

# Your production Google Maps map ID (browser-visible, not an API secret).
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Optional production tile service. Supply its required attribution alongside its URL.
# Default tiles: OpenStreetMap (interactive use only, no prefetch or offline downloads).
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Enable only after HTTPS is confirmed for every child of this app hostname.
HSTS_INCLUDE_SUBDOMAINS=false
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
